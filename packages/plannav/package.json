{
  "name": "plannav",
  "version": "0.1.0",
  "description": "A local-first calendar that plans your week from a baseline and adjusts the day when life interrupts. Chat assistant acts only through tested scheduling tools.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "plannav": "./bin/plannav.mjs" },
  "files": ["bin", "dist"],
  "engines": { "node": ">=22.13" },
  "repository": { "type": "git", "url": "git+https://github.com/jycd25/PlanNav.git" },
  "homepage": "https://github.com/jycd25/PlanNav#readme",
  "bugs": { "url": "https://github.com/jycd25/PlanNav/issues" },
  "keywords": ["calendar", "scheduler", "planner", "time-blocking", "local-first", "sqlite", "claude", "mcp", "assistant"],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "typecheck": "node --check build.mjs && node --check bin/plannav.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ds/core": "workspace:*",
    "@ds/server": "workspace:*",
    "@ds/web": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
