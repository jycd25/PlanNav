{
  "name": "@ds/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "mcp": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/mcp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@ds/core": "workspace:*",
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.13.0",
    "tsx": "^4.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0", "vitest": "^4.0.0" }
}
